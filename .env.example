# Google Gemini API key — used only by the serverless function in api/, never
# shipped to the browser. Vite exposes nothing to the client bundle unless the
# variable is prefixed VITE_, and this deliberately is not.
#
# Set a low spend cap on this key in Google AI Studio before deploying. The
# endpoint is public and linked from a public repository.
GEMINI_API_KEY=

# Kill switch. When true, /api/extract returns the matching pre-extracted
# example from src/data/examples.ts, makes no upstream call, and needs no key
# at all. Flip this if the key burns during the judging window.
DEMO_ONLY=false
